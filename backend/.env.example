# Copy to .env and fill in. Never commit .env.

# local | production
APP_ENV=local

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Postgres connection string (server only). For Supabase, end it with ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Separate database used only by the test suite. Its public schema is dropped and
# recreated on every test run, so never point this at real data.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/jr_sanzy_test

# Supabase project URL, used for the JWKS endpoint and the token issuer.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Only for legacy projects that sign tokens with a shared HS256 secret. Leave empty
# when the project uses JWKS signing keys.
SUPABASE_JWT_SECRET=
