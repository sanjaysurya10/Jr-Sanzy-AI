# Copy to .env.local. Only NEXT_PUBLIC_* values belong here; they are visible in the browser.

# Backend base URL, no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL and publishable (anon) key. Public by design. Never put the
# service-role key or the database URL here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
